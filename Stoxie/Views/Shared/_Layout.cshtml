<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stoxie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Stoxie.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow">
            <div class="container-fluid">
                
                <a class="navbar-brand fw-bold text-white" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Stoxie.png" alt="Stoxie Logo" style="height: 35px;" class="me-2" />
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="About">Hakkımızda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Portfolio" asp-action="Index">Portföyüm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Favorite" asp-action="Index">Favorilerim</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Market" asp-action="Index">Market</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Bist" asp-action="Index">BIST 100</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Contact">İletişim</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Kullanıcı dropdown menüsü -->
                            <div class="dropdown">
                                <button class="btn btn-outline-light dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    👋 @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" asp-controller="SignIn" asp-action="Welcome">👤 Profilim</a></li>
                                    <li>
                                        <form method="post" asp-controller="SignIn" asp-action="Logout" class="dropdown-item p-0">
                                            <button type="submit" class="btn w-100 text-start">🚪 Çıkış Yap</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Giriş yapılmamışsa klasik butonlar -->
                            <div class="d-flex">
                                <a class="btn btn-outline-light me-2" asp-controller="SignUp" asp-action="Register">Sign Up</a>
                                <a class="btn btn-outline-light" asp-controller="SignIn" asp-action="Login">Sign In</a>
                            </div>
                        }
                    </div>                    
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Stoxie - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
