<!-- HERO BANNER -->
<header class="bg-light text-dark text-center py-5 shadow-sm">
    <div class="container">
        <h1 class="display-5 fw-bold">Finans Takibini Stoxie ile Yap!</h1>
        <p class="lead">Portföyünü yönet, piyasalara göz at, favorilerini takip et — hepsi tek bir yerde.</p>
        <a href="#" class="btn btn-primary btn-lg mt-3">Hemen Başla</a>
    </div>
</header>

<!-- ALT ALAN -->
<section class="py-5 bg-white">
    <div class="container text-center">
        <h3 class="mb-4">Neler Sunuyoruz?</h3>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">📊 Portföyüm</h5>
                        <p class="card-text">Aldığın hisselerin anlık durumlarını gör.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">⭐ Favorilerim</h5>
                        <p class="card-text">İlgilendiğin hisseleri ve varlıkları kolayca takip et.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">💰 Market</h5>
                        <p class="card-text">Altın, döviz ve kripto varlıkların güncel değerleri burada.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">📈 BIST 100</h5>
                        <p class="card-text">En çok takip edilen hisselerin son durumu.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
