@model Stoxie.Models.ViewModel.UserLoginVM

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-5 text-center rounded" style="width: 450px;">
        <h2 class="text-success mb-4">
            <i class="fas fa-smile"></i> Hoş Geldin, @Model.FirstName @Model.LastName!
        </h2>
        <p class="text-muted">Sisteme başarıyla giriş yaptınız.</p>

        <hr />

        <div class="d-grid gap-2">
            <a href="@Url.Action("Login", "SignIn")" class="btn btn-outline-secondary">Çıkış Yap</a>
            <a href="@Url.Action("Register", "SignUp")" class="btn btn-outline-primary">Yeni Kullanıcı Oluştur</a>
        </div>
    </div>
</div>